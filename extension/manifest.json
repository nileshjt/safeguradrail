{
  "manifest_version": 3,
  "name": "Safeguradrail Sentinel",
  "version": "0.1.0",
  "description": "Enterprise guardrail that sits between AI browser extensions and your organisation's finance web tools.",
  "permissions": ["management", "storage", "alarms", "tabs", "webRequest", "webRequestBlocking"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/patterns.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Safeguradrail Sentinel" },
  "storage": { "managed_schema": "managed_schema.json" }
}
